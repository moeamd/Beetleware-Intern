// Day 5 — Event Loop Foundations Cheat Sheet (Final & Enhanced)
// Concepts: call stack, heap, task queue (macrotasks), microtask queue (promise jobs), timers, promises

//////////////////////////////
// The sections below include explanations for each concept.
//////////////////////////////
// 1. Call Stack Basics
//////////////////////////////

function one() {
  return 1;
}

function two() {
  return one() + 1;
}

function three() {
  return two() + 1;
}

console.log(three());
// Output: 3
// Why: one() → 1, two() → 2, three() → 3 (call stack executes functions top-down)
// The stack executes three() -> two() -> one()

//////////////////////////////
// 2. Call Stack with Error
//////////////////////////////

function errOne() {
  throw new Error("Oops"); // Error pushes onto stack and unwinds
}

function errTwo() {
  return errOne() + 1;
}

function errThree() {
  return errTwo() + 1;
}

// console.log(errThree());
// The error is thrown inside errOne() and propagates up the stack

//////////////////////////////
// 3. Recursion Example
//////////////////////////////

function recursion(num) {
  if (num >= 5) {
    return num;
  } else {
    return recursion(num + 1); // Each call goes onto the call stack
  }
}

console.log(recursion(0)); // Output: 5

//////////////////////////////
// 4. Blocking Code Example (Synchronous Execution)
//////////////////////////////

console.log("start");

function delay() {
  for (let i = 0; i < 1000000000; i++); // Simulated blocking loop (increased size)
  console.log("1 sec delay");
}

delay();
console.log("end");
// The loop blocks the stack before "end" runs. Output: start, 1 sec delay, end.

//////////////////////////////
// 5. Non‑Blocking Timer Example (Task/Macrotask)
//////////////////////////////

console.log("start 1");

setTimeout(function () {
  console.log("delay 3"); // Added to the Task Queue (Macrotask)
}, 1000);

console.log("end 2");
// Output: start 1, end 2, delay 3
// "end 2" executes immediately because timers go to the Task Queue and wait for the stack to clear.

//////////////////////////////
// 6. Stack vs Heap Basics
//////////////////////////////

const terryP = {
  firstName: "Terry",
  lastName: "Pratchett",
  profession: "author",
}; // Object stored in heap, reference in stack

function introduceTerry() {
  return `Hi, my name is ${terryP.firstName}.`;
}

const series = ["Discworld", "Johnny Maxwell", "Long Earth"]; // Array in heap
const isDone = true; // Primitive in stack

//////////////////////////////
// 7. Reference Copy (Objects)
//////////////////////////////

const bookShelf = {
  read: "Colour Of Magic",
  reading: "Night Watch",
  toRead: "Going Postal",
};

const newBookShelf = bookShelf; // Both variables reference the SAME heap object

bookShelf.reading = "Mort";
bookShelf.justFinished = "Night Watch";

console.log(bookShelf);
console.log(newBookShelf);
// Both show identical output because they reference the same object (Mutation affects both variables).

//////////////////////////////
// 8. Copying Primitives
//////////////////////////////

let book = "Guards! Guards! (Paperback)";
const bookToRead = book; // A real copy (by value)

book = "Guards! Guards! (Kindle Edition)";

console.log(book); // Updated (Guards! Guards! (Kindle Edition))
console.log(bookToRead); // Old value (Guards! Guards! (Paperback))

//////////////////////////////
// 9. Shallow Copy (Object.assign / Spread)
//////////////////////////////

const shelfA = {
  read: "Colour Of Magic",
  reading: "Night Watch",
  toRead: "Going Postal",
};

const shelfB = Object.assign({}, shelfA); // New object in heap, but nested objects are still references

shelfA.reading = "Mort";
shelfA.justFinished = "Night Watch";

console.log(shelfA);
console.log(shelfB); // Independent copy (for top-level properties)

//////////////////////////////
// 10. Deep Copy (Structured Clone / JSON) - NEW!
//////////////////////////////

const originalShelf = {
  books: ["The Colour Of Magic", "Mort"],
  owner: { name: "Rincewind" }, // Nested object
};

// Common but limited way (works for basic JSON-safe objects)
const deepCopyShelf = JSON.parse(JSON.stringify(originalShelf));

originalShelf.owner.name = "Vimes"; // Changing the nested object in the original

console.log(originalShelf.owner.name); // Vimes
console.log(deepCopyShelf.owner.name); // Rincewind (Independent deep copy)

//////////////////////////////
// 11. Promise Jobs (Microtask Queue) - HIGHEST PRIORITY - NEW!
//////////////////////////////

console.log("start A"); // 1. Runs first (Call Stack)

// The callback is sent to the Microtask Queue
Promise.resolve().then(() => {
  console.log("Promise Job D"); // 4. Runs before Macrotasks (High Priority)
});

// The callback is sent to the Task Queue (Macrotask)
setTimeout(() => {
  console.log("Macrotask E"); // 5. Runs after ALL Microtasks clear
}, 0);

console.log("end B"); // 2. Runs second (Call Stack)

// Another Promise Job is added
Promise.resolve().then(() => {
  console.log("Promise Job F"); // 6. Runs after D, but still before E
});

console.log("end C"); // 3. Runs third (Call Stack)

/*
Execution Flow (Event Loop Rule: Stack -> Microtasks -> Tasks):
1. start A
2. end B
3. end C
--- Stack is clear, Microtask Queue is checked ---
4. Promise Job D
5. Promise Job F
--- Microtask Queue is clear, Task Queue is checked ---
6. Macrotask E
*/

//////////////////////////////
// 12. Nested Event Loop Interactions (Task vs Microtask) - NEW!
//////////////////////////////

setTimeout(() => {
  console.log("Task 1"); // Macrotask 1
  Promise.resolve().then(() => {
    console.log("Microtask 2 (Inside Task 1)"); // Added to Microtask Queue for the *current tick*
  });
}, 0);

setTimeout(() => {
  console.log("Task 3"); // Macrotask 3 (Waits for all Microtasks from Task 1 to finish)
}, 0);

Promise.resolve().then(() => {
  console.log("Microtask 4 (Initial)"); // Microtask 4
});

/*
Execution Flow:
1. Microtask 4 (Clears initial Microtask Queue)
--- New tick begins ---
2. Task 1 (Pulled from Task Queue)
3. Microtask 2 (The promise inside Task 1 is resolved immediately, clearing the Microtask Queue again)
4. Task 3 (Pulled from Task Queue)
*/